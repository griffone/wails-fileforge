{
  "name": "fileforge-desktop",
  "version": "1.1.0",
  "info": {
    "companyName": "FileForge",
    "productName": "FileForge Desktop",
    "productIdentifier": "com.fileforge.desktop",
    "description": "Cross-platform file conversion toolkit",
    "copyright": "(c) 2026, FileForge",
    "comments": "Local-first file workbench",
    "version": "1.1.0"
  },
  "build": {
    "appName": "FileForge Desktop",
    "assetDir": "frontend/dist/frontend/browser",
    "webDir": "frontend/dist/frontend/browser",
    "frontendBuildCommand": "cd frontend && npm run build",
    "frontendDevCommand": "cd frontend && npm run start",
    "frontendDevServerURL": "http://localhost:4200"
  },
  "capabilities": {
    "filesystem": true
  }
}
